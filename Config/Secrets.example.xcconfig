// Copy the shape below into Config/Secrets.xcconfig (gitignored), or just run
// scripts/sync-secrets.sh after filling in .env — it generates this file for you.
//
// Note the $() between the slashes in the URL: .xcconfig treats a bare `//` as a comment
// marker, which would otherwise truncate the URL right after the scheme.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
